{
  "name": "ai-reponder",
  "version": "1.0.0",
  "description": "AI-powered writing assistant that monitors text across desktop applications and provides real-time grammar and writing suggestions",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac-dmg": "electron-builder --mac dmg",
    "build:mac-zip": "electron-builder --mac zip",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "npm run build:mac",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=\"tests/(main|ai-service|text-monitor|suggestion-overlay|renderer).test.js\"",
    "test:integration": "jest --testPathPattern=\"tests/integration.test.js\"",
    "test:performance": "jest --testPathPattern=\"tests/performance.test.js\"",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "prepare": "husky install"
  },
  "keywords": [
    "ai",
    "writing",
    "assistant",
    "grammar",
    "electron",
    "desktop",
    "perplexity",
    "text-monitoring"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "active-win": "^7.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/jest": "^29.5.8",
    "electron": "^38.2.2",
    "electron-builder": "^24.9.1",
    "eslint": "^9.37.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.2.0"
  },
  "build": {
    "appId": "com.ai-reponder.app",
    "productName": "AI Responder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.test.js",
      "!tests/**/*",
      "!**/*.md",
      "!.git/**/*"
    ],
    "asarUnpack": [
      "node_modules/dotenv/**/*",
      "node_modules/@google/generative-ai/**/*",
      "node_modules/axios/**/*",
      "node_modules/active-win/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/openai/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "title": "AI Responder",
      "icon": "assets/icon.icns",
      "background": "assets/dmg-background.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": null
  }
}
